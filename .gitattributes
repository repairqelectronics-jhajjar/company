# Normalize line endings for the whole repo
* text=auto

# Force LF for web files (HTML, CSS, JS, JSON, XML, TXT, MD)
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf

# Binary files — no EOL conversion
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
